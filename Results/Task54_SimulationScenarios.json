 "depth_definitions": {
  "2/3/5/10/30": "both sites that many fragments",
  "5/30": "site i 5, site j 30",
  "heterogeneous": "per donor, both sites 2 + NegBin(mean 10, size 2)"
 },
 "shared_definition": "r = round(shared * min(N_i, N_j)) fragments call both sites; the rest call one site",
 "coupling_definition": "q11 = (1 - |eta|) p_i p_j + |eta| q_bound; q_bound = min(p_i, p_j) if eta >= 0 else max(0, p_i + p_j - 1)",
 "violation_definitions": {
  "pcr_duplicates": "each fragment is copied 1 + Poisson(0.3) times with identical calls",
  "nonrepresentative_shared": "shared fragments use logit p + 0.5 at both sites",
  "conversion_errors": "each unmethylated call read as methylated w.p. 0.02, each methylated call read as unmethylated w.p. 0.02",
  "state_dependent_loss": "methylated calls lost w.p. 0.20, unmethylated w.p. 0.05",
  "informative_coverage": "site depth 4 + Poisson(12 p) per donor and site; r = round(min depth)",
  "cell_mixture": "each donor a mixture of cell A (both sites methylated w.p. 0.9) and cell B (0.1), fraction ~ Beta(2, 5); each fragment comes from one cell"
 },
 "targets": {
  "conditional": "T (covariance, n-1), T_ii, T_jj, Q = mean (p_i - p_j)^2 over the eligible donors",
  "population": "Cov(p_i, p_j), Var, E[(p_i - p_j)^2] from 4,000,000 latent draws"
 },

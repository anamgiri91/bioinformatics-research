> # H4: F+ within 0.0005 of Codex F in both outcomes at every length scale
> h4 <- dcast(fr[family %in% c("Codex F", "F+")], cohort + subset + ell ~ family, value.var = c("error", "gain"))
> setnames(h4, c("cohort", "subset", "ell", "eF", "eP", "gF", "gP"))

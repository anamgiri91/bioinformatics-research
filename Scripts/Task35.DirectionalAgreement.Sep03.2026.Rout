> rows <- list()
> 
> for (tissue in c("Normal", "Tumor")) {
+   cat("#########################################################\n")
+   cat("### ", tissue, "\n", sep = "")
+   cat("#########################################################\n\n")
+ 
+   cols <- paste0(substr(tissue, 1, 1), 1:53)
+ 
+   nrm <- read_any(inputs$Normal, tab = TRUE)
+   n22 <- nrm[nrm$Chromosome == "chr22", ]; n22 <- n22[order(n22$Start), ]
+   win_ids <- n22$Composite.Element.REF[seq_len(N_WINDOW)]
+   rm(nrm, n22); invisible(gc())
+ 
+   d <- read_any(inputs[[tissue]], tab = TRUE)
+   d <- d[d$Chromosome == "chr22", ]; d <- d[order(d$Start), ]
+   ids <- d$Composite.Element.REF
+   B_all <- as.matrix(d[, cols, drop = FALSE]); storage.mode(B_all) <- "numeric"
+   rownames(B_all) <- ids; colnames(B_all) <- cols
+   st_all <- d$methy.state; rm(d); invisible(gc())
+ 
+   get_flag <- function(which) {
+     fx <- read_any(flags[[tissue]][[which]])
+     M <- as.matrix(fx[match(ids, fx$cgID), cols, drop = FALSE])
+     storage.mode(M) <- "numeric"; dimnames(M) <- list(ids, cols); M
+   }
+   self_all <- get_flag("self"); ext_all <- get_flag("ext"); invisible(gc())
+ 
+   for (scope in c("window", "chr22")) {
+     idx <- if (scope == "window") match(win_ids, ids) else seq_along(ids)
+     idx <- idx[!is.na(idx)]
+     B <- B_all[idx, , drop = FALSE]; st <- st_all[idx]
+     M <- list(bio     = build_bio(B, st, FALSE),
+               bio.loo = build_bio(B, st, TRUE),
+               self    = self_all[idx, , drop = FALSE],
+               ext     = ext_all[idx, , drop = FALSE])
+ 
+     cat("--- scope = ", scope, "  (", nrow(B), " sites)\n", sep = "")
+     pairs <- list(c("bio","ext"), c("bio.loo","ext"), c("self","ext"),
+                   c("bio","self"), c("bio","bio.loo"))
+     for (pr in pairs) {
+       for (s in c("ALL", STATE_ORDER)) {
+         k <- if (s == "ALL") seq_along(st) else which(st == s)
+         if (!length(k)) next
+         r <- score_pair(M[[pr[1]]][k, , drop = FALSE],
+                         M[[pr[2]]][k, , drop = FALSE],
+                         pr[1], pr[2], tissue, scope, s)
+         if (!is.null(r)) rows[[length(rows) + 1]] <- r
+       }
+       # the ALL row for this pair is the one printed
+       rall <- Filter(function(z) z$method.a == pr[1] && z$method.b == pr[2] &&
+                        z$stratum == "ALL" && z$scope == scope &&
+                        z$tissue == tissue, rows)[[1]]
+       cat(sprintf("   %-8s vs %-5s  jaccard +1 %-7s  -1 %-7s  opposite %5.2f%% of either  |  precision %-7s recall %-7s\n",
+           pr[1], pr[2],
+           format(rall$jaccard.pos), format(rall$jaccard.neg),
+           rall$pct.opposite.of.either,
+           format(rall$precision), format(rall$recall)))
+     }
+     cat("\n")
+     rm(M); invisible(gc())
+   }
+   rm(B_all, self_all, ext_all); invisible(gc())
+ }

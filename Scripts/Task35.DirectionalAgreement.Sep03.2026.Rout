> # ---------------------------------------------------------------
> # the state-aware rule, and its leave-one-out variant.
> #
> # LOO is vectorised via one sort per row rather than 53 quantile()
> # calls per row - the naive form is ~360,000 calls on chr22 and takes
> # minutes. The k-th order statistic of "everyone except sample j" is
> # S[k] when k < rank(j) and S[k+1] otherwise, so the type-7 quantile
> # over the other 52 is two lookups and a lerp. Same numbers.
> # ---------------------------------------------------------------
> build_bio <- function(B, st, loo = FALSE) {
+   n <- ncol(B); m <- n - 1L
+   o <- matrix(0L, nrow(B), ncol(B), dimnames = dimnames(B))
+   elig <- which(st %in% c("L", "LM", "H", "HM"))
+   for (i in elig) {
+     v <- as.numeric(B[i, ])
+     if (all(is.na(v))) { o[i, ] <- NA; next }
+     hi <- st[i] %in% c("L", "LM")
+     p  <- if (hi) 1 - P_LEVEL else P_LEVEL
+     if (!loo) {
+       thr <- quantile(v, p, na.rm = TRUE, names = FALSE)
+       o[i, ] <- if (hi) as.integer(v > thr) else -as.integer(v < thr)
+     } else {
+       if (anyNA(v)) { o[i, ] <- NA; next }   # a LOO threshold from a
+       S <- sort(v)                            # different n is not comparable
+       R <- rank(v, ties.method = "first")
+       ostat <- function(k, j) { k <- min(max(k, 1L), m)
+         S[if (k < R[j]) k else k + 1L] }
+       h <- (m - 1) * p + 1; lo <- floor(h); fr <- h - lo
+       for (j in seq_len(n)) {
+         a <- ostat(lo, j)
+         thr <- if (fr == 0) a else a + fr * (ostat(lo + 1L, j) - a)
+         o[i, j] <- if (hi) as.integer(v[j] > thr) else -as.integer(v[j] < thr)
+       }
+     }
+     o[i, is.na(v)] <- NA
+   }
+   o[is.na(B)] <- NA
+   o
+ }
> 
> score_pair <- function(A, Bm, label_a, label_b, tissue, scope, stratum) {
+   ok <- !is.na(A) & !is.na(Bm)
+   a <- A[ok]; b <- Bm[ok]
+   n <- length(a)
+   if (!n) return(NULL)
+   cnt <- function(x, y) sum(a == x & b == y)
+   n_pp <- cnt(1, 1); n_nn <- cnt(-1, -1)
+   n_pn <- cnt(1, -1); n_np <- cnt(-1, 1)
+   n_p0 <- cnt(1, 0);  n_0p <- cnt(0, 1)
+   n_n0 <- cnt(-1, 0); n_0n <- cnt(0, -1)
+   a_pos <- sum(a == 1); a_neg <- sum(a == -1)
+   b_pos <- sum(b == 1); b_neg <- sum(b == -1)
+   either <- sum(a != 0 | b != 0)
+   jac <- function(both, ua, ub) { u <- ua + ub - both
+     if (!u) NA_real_ else round(both / u, 4) }
+   data.frame(
+     tissue = tissue, scope = scope, stratum = stratum,
+     method.a = label_a, method.b = label_b,
+     n.compared = n,
+     a.pos1 = a_pos, a.neg1 = a_neg, b.pos1 = b_pos, b.neg1 = b_neg,
+     # --- the 3x3, the cells that matter ---
+     both.pos1 = n_pp, both.neg1 = n_nn,
+     opposite.a.pos.b.neg = n_pn, opposite.a.neg.b.pos = n_np,
+     a.pos.b.zero = n_p0, a.zero.b.pos = n_0p,
+     a.neg.b.zero = n_n0, a.zero.b.neg = n_0n,
+     # --- agreement, one direction at a time ---
+     jaccard.pos = jac(n_pp, a_pos, b_pos),
+     jaccard.neg = jac(n_nn, a_neg, b_neg),
+     n.either = either,
+     pct.opposite.of.either = if (either) round(100 * (n_pn + n_np) / either, 3) else NA_real_,
+     # --- b treated as the reference ---
+     precision = if (a_pos + a_neg) round((n_pp + n_nn) / (a_pos + a_neg), 4) else NA_real_,
+     recall    = if (b_pos + b_neg) round((n_pp + n_nn) / (b_pos + b_neg), 4) else NA_real_,
+     precision.pos = if (a_pos) round(n_pp / a_pos, 4) else NA_real_,
+     recall.pos    = if (b_pos) round(n_pp / b_pos, 4) else NA_real_,
+     precision.neg = if (a_neg) round(n_nn / a_neg, 4) else NA_real_,
+     recall.neg    = if (b_neg) round(n_nn / b_neg, 4) else NA_real_)
+ }

> titled <- function(title, ..., widths = NULL) {
+   arrangeGrob(..., ncol = length(list(...)), widths = widths,
+     top = textGrob(title, x = unit(12, "pt"), hjust = 0,
+                    gp = gpar(fontsize = 14, fontface = "bold", col = INK)))
+ }
> r4 <- function(x) round(x, 4)
> pct <- function(x, d = 1) paste0(formatC(100 * x, format = "f", digits = d), "%")
> # ink or white text on a coloured fill, by the fill's luminance
> on_fill <- function(hex) {
+   rgb <- col2rgb(hex) / 255
+   lin <- ifelse(rgb <= 0.03928, rgb / 12.92, ((rgb + 0.055) / 1.055)^2.4)
+   lum <- 0.2126 * lin[1, ] + 0.7152 * lin[2, ] + 0.0722 * lin[3, ]
+   ifelse(lum > 0.2, INK, "white")
+ }

> # ----------------------------------------------------------------
> # Fig27  item 3: OutlierMeth with the CG ID replaced or removed
> # ----------------------------------------------------------------
> idt <- rd("Task40_IDTest.csv")
> # outcome category, and the share of cells that differ (for wrong flags)
> outcome <- function(r) {
+   if (startsWith(r$result, "error")) return(list("Stops with an error", NA_real_))
+   if (r$identical_cells == r$cells) return(list("Same in every cell", NA_real_))
+   if (r$NA_cells == r$cells) return(list("No flags at all\n(every cell NA)", NA_real_))
+   list("Wrong flags", r$different_cells / r$cells)
+ }
> fill27 <- c("Same in every cell" = GOOD, "Stops with an error" = SERIOUS,
+             "No flags at all\n(every cell NA)" = CRITICAL, "Wrong flags" = CRITICAL, "Not run" = NOTRUN)
> self <- idt[reference == "self (53 samples)" & row_names != "cgID, this run"]
> key27 <- c("cgID" = "CG ID\n(cg13869341)", "chr:position" = "Chromosome and position\n(chr1:15865)",
+            "position only" = "Position number only\n(15865)", "none" = "No ID")
> col27 <- c("Self reference,\nTask 13's call", "Self reference,\nplain call",
+            "External panel\nlabelled by CG ID", "External panel\nrelabelled to match")
> cell <- function(tis, ids, col) {
+   r <- switch(col,
+     "Self reference,\nTask 13's call" = self[tissue == tis & row_names == ids & call == "Task 13 call"],
+     "Self reference,\nplain call"     = self[tissue == tis & row_names == ids & call == "plain call"],
+     "External panel\nlabelled by CG ID" = idt[tissue == tis & grepl("^external", reference) &
+                                               row_names == ids & call == "panel keyed by cgID"],
+     "External panel\nrelabelled to match" = if (ids == "cgID")
+         idt[tissue == tis & grepl("^external", reference) & row_names == "cgID"] else
+         idt[tissue == tis & grepl("^external", reference) & row_names == ids & grepl("renamed", call)])
+   if (!nrow(r)) return(list("Not run", NA_real_))
+   outcome(r[1])
+ }
> grid27 <- function(tis) rbindlist(lapply(names(key27), function(ids) rbindlist(lapply(col27, function(col) {
+   o <- cell(tis, ids, col); data.table(ids, col, category = o[[1]], differ = o[[2]]) }))))
> g27 <- grid27("Normal")
> t27 <- grid27("Tumor")
> # the tumour self-reference outcomes must fall in the same categories
> stopifnot(identical(g27[grepl("^Self", col), category], t27[grepl("^Self", col), category]))
> g27[grepl("^Self", col), differ_t := t27[grepl("^Self", col), differ]]
> g27[, text := fifelse(category == "Wrong flags",
+                       sprintf("Wrong flags\n(%s to %s of cells differ)",
+                               pct(pmin(differ, differ_t, na.rm = TRUE)),
+                               pct(pmax(differ, differ_t, na.rm = TRUE))), category)]
> g27[, fill := fill27[category]]
> g27[, `:=`(row = factor(key27[ids], levels = rev(key27)), column = factor(col, levels = col27))]
> g27[, txtcol := fifelse(fill == NOTRUN, MUTED, on_fill(fill))]
> p27 <- ggplot(g27, aes(column, row)) +
+   geom_tile(aes(fill = fill), colour = SURF, linewidth = 2.5) +
+   geom_text(aes(label = text, colour = txtcol), size = 3.3, lineheight = 0.95) +
+   scale_fill_identity() + scale_colour_identity() +
+   scale_x_discrete(position = "top") +
+   labs(title = "OutlierMeth only gives the same output when the ID is unique and shared by both tables",
+        subtitle = paste0("All 380,355 sites x 53 samples, compared cell by cell with the run that keeps the ",
+                          "CG ID.\nSelf-reference results were the same in normal and tumour. ",
+                          "The external panel is a stand-in built from the 32 Dead normal samples."),
+        x = NULL, y = NULL,
+        caption = "Source: Results/Task40_IDTest.csv (Task 40). Not run: that combination was not tested.") +
+   theme(panel.grid.major = element_blank(), axis.text = element_text(colour = INK, size = 9.5))
> save_fig("Fig27_OutlierMeth_IDTest.png", p27, 11.5, 5.4)

> # ----------------------------------------------------------------
> # Fig21  item 6: the six states, with one real RRBS site each
> # ----------------------------------------------------------------
> cs <- fread(file.path(res, "Task39_RRBS_CompleteSiteStates.csv.gz"))
> sc <- rd("Task39_RRBS_StateCounts.csv")
> d  <- fread(rrbs, na.strings = "NA", showProgress = FALSE)
> samp <- grep("^P[0-9]+NF$", names(d), value = TRUE)
> # the example for each state: the complete site whose median is closest
> # to the median of that state's site medians (first by position on ties)
> pick <- rbindlist(lapply(states, function(s) {
+   x <- cs[state == s]; tgt <- median(x$Median)
+   x[order(abs(Median - tgt), pos)][1, .(state = s, pos)]
+ }))
> vals <- rbindlist(lapply(seq_len(nrow(pick)), function(i)
+   data.table(state = pick$state[i], beta = as.numeric(unlist(d[pos == pick$pos[i], ..samp])))))
> rm(d); invisible(gc())
> tsg <- function(m) {   # the TSG rule, to confirm each example's state
+   if (all(m < .2)) "L" else if (all(m > .8)) "H" else if (!any(m < .2) && !any(m > .8)) "M"
+   else if (all(m > .4)) "HM" else if (all(m < .6)) "LM" else "R" }
> stopifnot(vals[, .N, by = state]$N == 18, !anyNA(vals$beta),
+           identical(vals[, tsg(beta), by = state]$V1, states))
> vals[, yrow := match(state, rev(states))]
> vals[, k := .N, by = .(state, beta)][, j := seq_len(.N), by = .(state, beta)]
> vals[, y := yrow + fifelse(k > 1, (j - (k + 1) / 2) * pmin(0.62 / (k - 1), 0.11), 0)]
> bands <- data.table(state = states, xmin = c(0, 0, 0.2, 0.4, 0.8, 0), xmax = c(0.2, 0.6, 0.8, 1, 1, 1))
> bands[, yrow := match(state, rev(states))]
> rule <- c(L = "all below 0.2", LM = "all below 0.6 (not L or M)", M = "all from 0.2 to 0.8",
+           HM = "all above 0.4 (not H or M)", H = "all above 0.8", R = "none of the above")
> sc[, lab := paste0(state, ":  ", rule[as.character(state)], "\n", comma(N), " sites (", pct(share), ")")]
> ylabs <- sc$lab[match(states, sc$state)]
> p21 <- ggplot() +
+   geom_rect(data = bands, aes(xmin = xmin, xmax = xmax, ymin = yrow - 0.4, ymax = yrow + 0.4),
+             fill = BLUE, alpha = 0.10) +
+   geom_vline(xintercept = c(0.2, 0.4, 0.6, 0.8), colour = MUTED, linewidth = 0.35) +
+   geom_point(data = vals, aes(beta, y), shape = 21, fill = BLUE, colour = SURF,
+              stroke = 0.7, size = 2.6) +
+   scale_x_continuous(breaks = seq(0, 1, 0.2), expand = expansion(add = 0.02)) +
+   scale_y_continuous(breaks = 6:1, labels = ylabs, expand = expansion(add = 0.5)) +
+   labs(title = "The six methylation states of the TSG paper, with one real RRBS site each",
+        subtitle = paste0("Shaded: where all 18 values of a site must lie. Dots: the 18 samples of one ",
+                          "complete RRBS site in that state\n(the site with the most typical median). ",
+                          "Vertical lines: the cut-offs 0.2, 0.4, 0.6 and 0.8."),
+        x = "Methylation level (beta)", y = NULL,
+        caption = paste0("Sources: Data/NN.hg38.18P.forw.chr22.w.header.txt, ",
+                         "Results/Task39_RRBS_CompleteSiteStates.csv.gz and Task39_RRBS_StateCounts.csv"))
> save_fig("Fig21_RRBS_StateDefinitions.png", p21, 11, 6.6)

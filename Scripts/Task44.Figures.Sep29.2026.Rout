> # ----------------------------------------------------------------
> # Fig26  item 1(3): what the +100 offset does to beta (arithmetic)
> # ----------------------------------------------------------------
> tot <- 10^seq(log10(300), log10(20000), length.out = 300)
> off <- CJ(true_beta = c(0.95, 0.5, 0.05), total = tot)
> off[, drop := true_beta * 100 / (total + 100)]
> off[, series := factor(paste("True beta", true_beta), levels = paste("True beta", c(0.95, 0.5, 0.05)))]
> pts <- rd("Task40_OffsetArithmetic.csv")
> pts[, series := factor(paste("True beta", true_beta), levels = levels(off$series))]
> stopifnot(max(abs(pts$shift_down - pts$true_beta * 100 / (pts$total_signal + 100))) < 1e-4)
> ends <- off[total == min(total)]

> write_out <- function(tbl, fname) {
+   path <- file.path(out_dir, fname)
+   write.csv(tbl, path, row.names = FALSE)
+   cat("  written:", path, " (", nrow(tbl), " rows )\n", sep = "")
+   invisible(path)

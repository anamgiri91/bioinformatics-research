> # working copy, so the same script runs unmodified in both places.
> pick_dir <- function(...) {
+   cand <- c(...)
+   for (d in cand) if (dir.exists(d)) return(d)
+   stop("no candidate directory exists:\n  ", paste(cand, collapse = "\n  "))
+ }

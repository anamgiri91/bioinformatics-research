> scores <- list(); effects <- list(); budgets <- list(); burden <- list()
> add_method <- function(name, SC, SS, SN, scC = NULL, scS = NULL) {
+   scores[[name]]  <<- score_calls(SC, SS, SN, spB, meta, cols, SHIFTED$Normal, name)
+   effects[[name]] <<- recall_by_effect(SS, spB, name)
+   if (!is.null(scC)) budgets[[name]] <<- budget_recall(scC, scS, spB, meta, name)
+   burden[[name]]  <<- data.table(tissue = "Normal", method = name, sample = cols,
+                                  calls = colSums(SC[!meta$masked, ] != 0))
+   say("  %-18s recall %.3f  single %.3f  region events %.3f  calls/sample %.0f  contrary %.1f%%  shifted ratio %.2f  stability %.3f",
+       name, scores[[name]]$recall.cells, scores[[name]]$recall.single,
+       scores[[name]]$recall.region.events, scores[[name]]$calls.per.sample.clean,
+       scores[[name]]$pct.contrary, scores[[name]]$shifted.array.burden.ratio,
+       scores[[name]]$stability)
+ }

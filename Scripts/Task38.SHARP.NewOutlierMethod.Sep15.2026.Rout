> # ------------------------------------------------
> # baselines, all on the full matrix; scores signed by direction
> # ------------------------------------------------
> ext_thresholds <- function(B, F) {
+   up <- F == 1 & !is.na(F); dn <- F == -1 & !is.na(F)
+   Bu <- B; Bu[!up] <- NA; Bnu <- B; Bnu[up] <- NA
+   Bd <- B; Bd[!dn] <- NA; Bnd <- B; Bnd[dn] <- NA
+   anyu <- rowAnys(up); anyd <- rowAnys(dn)
+   P <- ifelse(anyu, (suppressWarnings(rowMins(Bu, na.rm = TRUE)) +
+                      suppressWarnings(rowMaxs(Bnu, na.rm = TRUE))) / 2, rowMaxs(B))
+   N <- ifelse(anyd, (suppressWarnings(rowMaxs(Bd, na.rm = TRUE)) +
+                      suppressWarnings(rowMins(Bnd, na.rm = TRUE))) / 2, rowMins(B))
+   na <- rowAlls(is.na(F)); P[na] <- NA; N[na] <- NA
+   list(P = P, N = N)
+ }
> ext_calls <- function(B, th, floor = 0) {
+   S <- (B > th$P) - (B < th$N); S[is.na(S)] <- 0
+   if (floor > 0) S <- S * (abs(B - rowMedians(B)) >= floor)
+   S
+ }
> ext_score <- function(B, th, floor = 0) {
+   up <- B - th$P; dn <- th$N - B
+   sc <- ifelse(up >= dn, up, -dn); sc[is.na(sc)] <- 0
+   if (floor > 0) sc <- sc * (abs(B - rowMedians(B)) >= floor)
+   sc
+ }
> sem_parts <- function(B) {
+   q <- rowQuantiles(B, probs = c(0.25, 0.75), type = 7)
+   iqr <- pmax(q[, 2] - q[, 1], 1e-4)
+   list(lo = (q[, 1] - B) / iqr, hi = (B - q[, 2]) / iqr)
+ }
> sem_calls <- function(B) { p <- sem_parts(B); (p$hi > 3) - (p$lo > 3) }
> sem_score <- function(B) { p <- sem_parts(B); ifelse(p$hi >= p$lo, p$hi, -p$lo) }
> bio_dev <- function(B, st, q = 0.96, score = FALSE) {
+   X <- B - rowMedians(B); o <- matrix(0, nrow(X), ncol(X))
+   for (s in STATES) {
+     k <- which(st == s); if (!length(k)) next
+     pool <- as.vector(X[k, ]); tl <- TAIL[[s]]
+     hi <- if (tl == "upper") quantile(pool, q, names = FALSE) else
+           if (tl == "both") quantile(pool, 1 - (1 - q) / 2, names = FALSE) else Inf
+     lo <- if (tl == "lower") quantile(pool, 1 - q, names = FALSE) else
+           if (tl == "both") quantile(pool, (1 - q) / 2, names = FALSE) else -Inf
+     Xs <- X[k, , drop = FALSE]
+     o[k, ] <- if (score) ifelse(Xs - hi >= lo - Xs, Xs - hi, -(lo - Xs)) else (Xs > hi) - (Xs < lo)
+   }
+   if (score) { o[!is.finite(o)] <- 0 }
+   o
+ }
> epimut_calls <- function(B, link) {
+   n <- ncol(B); h <- (n - 2) * 0.995 + 1; fr <- h - floor(h); lo_i <- floor(h)
+   o <- sapply(c(1, 2, 3, n - 2, n - 1, n), function(w) rowOrderStats(B, which = w))
+   # leave-one-out 99.5% quantile of the other n-1 values, for the two largest
+   # values of each row (only they can exceed it) - and mirrored for the low tail
+   up_if_max <- o[, 4] + fr * (o[, 5] - o[, 4])
+   up_if_2nd <- o[, 4] + fr * (o[, 6] - o[, 4])
+   dn_if_min <- o[, 3] - fr * (o[, 3] - o[, 2])
+   dn_if_2nd <- o[, 3] - fr * (o[, 3] - o[, 1])
+   med <- rowMedians(B)
+   S <- ((B == o[, 6] & B > up_if_max) | (B == o[, 5] & B > up_if_2nd)) -
+        ((B == o[, 1] & B < dn_if_min) | (B == o[, 2] & B < dn_if_2nd))
+   S <- S * (abs(B - med) >= 0.15)
+   sign(S) * run_calls(S, link)
+ }

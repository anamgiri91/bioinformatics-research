> # ------------------------------------------------
> # spike-ins
> # ------------------------------------------------
> make_spikes <- function(meta, cols, seed, exclude = NULL) {
+   set.seed(seed)
+   ok <- which(!meta$masked)
+   dir_of <- function(st) ifelse(st %in% c("L", "LM"), 1L, ifelse(st %in% c("H", "HM"), -1L,
+                          sample(c(-1L, 1L), length(st), replace = TRUE)))
+   ev <- list(); eid <- 0L
+   chain_ok <- which(!meta$masked & c(meta$link[-1], FALSE) &
+                     c(meta$link[-(1:2)], FALSE, FALSE) &
+                     !c(meta$masked[-1], TRUE) & !c(meta$masked[-(1:2)], TRUE, TRUE))
+   for (pi in PIS) {
+     rs <- sample(ok, N_SINGLE); js <- sample.int(length(cols), N_SINGLE, replace = TRUE)
+     for (t in seq_len(N_SINGLE)) { eid <- eid + 1L
+       ev[[eid]] <- data.table(event = eid, kind = "single", pi = pi, row = rs[t], col = js[t],
+                               dir = dir_of(meta$st[rs[t]])) }
+     seeds <- sample(chain_ok, N_REGION); jr <- sample.int(length(cols), N_REGION, replace = TRUE)
+     for (t in seq_len(N_REGION)) {
+       want <- sample(3:6, 1); r <- seeds[t]; rr <- r
+       while (length(rr) < want && r + 1 <= nrow(meta) && meta$link[r + 1] && !meta$masked[r + 1]) {
+         r <- r + 1; rr <- c(rr, r) }
+       eid <- eid + 1L
+       d0 <- dir_of(meta$st[seeds[t]])
+       ev[[eid]] <- data.table(event = eid, kind = "region", pi = pi, row = rr, col = jr[t], dir = d0)
+     }
+   }
+   sp <- rbindlist(ev)
+   sp <- sp[!duplicated(sp[, .(row, col)])]
+   if (!is.null(exclude)) sp <- sp[!paste(row, col) %in% paste(exclude$row, exclude$col)]
+   sp
+ }
> apply_spikes <- function(B, sp) {
+   Bs <- B; cell <- cbind(sp$row, sp$col); b <- B[cell]
+   nb <- ifelse(sp$dir > 0, b + sp$pi * (1 - b), b * (1 - sp$pi))
+   Bs[cell] <- nb
+   sp[, realised := abs(nb - b)]
+   Bs
+ }
> EFFECT_BINS <- c(0, 0.05, 0.10, 0.20, 0.30, 1.01)
> EFFECT_LAB  <- c("<0.05", "0.05-0.10", "0.10-0.20", "0.20-0.30", ">=0.30")
> 
> # ------------------------------------------------
> # scoring a call matrix (full-size signed matrix, 0 = no call)
> # ------------------------------------------------
> full_matrix <- function(res, part, nr, nc) {
+   S <- matrix(0, nr, nc); S[res$rows, ] <- res[[part]]; S
+ }
> score_calls <- function(S_clean, S_spiked, S_noisy, sp, meta, cols, shifted, method, tissue = "Normal") {
+   univ <- which(!meta$masked)
+   cell <- cbind(sp$row, sp$col)
+   hit <- S_spiked[cell] == sp$dir
+   spk <- copy(sp)[, hit := hit]
+   bg_clean <- colSums(S_clean[univ, ] != 0)
+   spike_mask <- matrix(FALSE, nrow(S_spiked), ncol(S_spiked)); spike_mask[cell] <- TRUE
+   bg_spiked <- sum(S_spiked[univ, ] != 0 & !spike_mask[univ, ])
+   st <- meta$st
+   contr <- 0; tot <- 0
+   for (s in names(CONTRARY)) { k <- intersect(univ, which(st == s))
+     contr <- contr + sum(S_clean[k, ] == CONTRARY[[s]]); tot <- tot + sum(S_clean[k, ] != 0) }
+   a <- S_clean[univ, ]; b <- S_noisy[univ, ]
+   u <- sum(a != 0 | b != 0); stab <- if (u) sum(a != 0 & a == b) / u else NA
+   sh <- cols %in% shifted
+   reg <- spk[kind == "region", .(det = mean(hit) >= 0.5), by = event]
+   data.table(tissue = tissue, method = method,
+     recall.cells = round(mean(spk$hit), 4),
+     recall.single = round(spk[kind == "single", mean(hit)], 4),
+     recall.region.events = round(mean(reg$det), 4),
+     calls.per.sample.clean = round(mean(bg_clean), 1),
+     median.calls.per.sample = median(bg_clean),
+     spike.precision = round(sum(spk$hit) / (sum(spk$hit) + bg_spiked), 4),
+     pct.contrary = round(100 * contr / max(tot, 1), 2),
+     shifted.array.burden.ratio = round(mean(bg_clean[sh]) / max(median(bg_clean[!sh]), 1), 2),
+     stability = round(stab, 4))
+ }
> recall_by_effect <- function(S_spiked, sp, method) {
+   spk <- copy(sp)[, hit := S_spiked[cbind(row, col)] == dir]
+   spk[, effect := cut(realised, EFFECT_BINS, EFFECT_LAB, right = FALSE)]
+   spk[, .(n = .N, recall = round(mean(hit), 4)), by = .(kind, effect)][, method := method][]
+ }
> budget_recall <- function(sc_clean, sc_spiked, sp, meta, method, budget = BUDGET) {
+   univ <- which(!meta$masked)
+   thr <- quantile(abs(sc_clean[univ, ]), 1 - budget, names = FALSE)
+   if (thr <= 0) thr <- .Machine$double.eps
+   v <- sc_spiked[cbind(sp$row, sp$col)]
+   hit <- abs(v) >= thr & sign(v) == sp$dir
+   spk <- copy(sp)[, hit := hit]
+   reg <- spk[kind == "region", .(det = mean(hit) >= 0.5), by = event]
+   data.table(method = method, budget = budget, threshold = signif(thr, 4),
+              realised.clean.rate = round(mean(abs(sc_clean[univ, ]) >= thr), 5),
+              recall.cells = round(mean(hit), 4),
+              recall.single = round(spk[kind == "single", mean(hit)], 4),
+              recall.region.events = round(mean(reg$det), 4))
+ }

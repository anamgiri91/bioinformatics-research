> # ------------------------------------------------
> # helpers
> # ------------------------------------------------
> trigammaInverse <- function(x) {            # limma's Newton iteration
+   y <- 0.5 + 1 / x
+   for (i in 1:60) { tri <- trigamma(y); dif <- tri * (1 - tri / x) / psigamma(y, 2)
+     y <- y + dif; if (max(-dif / y) < 1e-8) break }
+   y
+ }
> fit_prior <- function(s2, d) {              # limma fitFDist, method of moments
+   s2 <- pmax(s2, 1e-10); e <- log(s2) - digamma(d / 2) + log(d / 2)
+   evar <- var(e) - trigamma(d / 2)
+   if (evar > 0) { d0 <- 2 * trigammaInverse(evar)
+     s02 <- exp(mean(e) + digamma(d0 / 2) - log(d0 / 2)) }
+   else { d0 <- Inf; s02 <- exp(mean(e)) }
+   c(d0 = d0, s02 = s02)
+ }
> 
> # runs of consecutive same-sign candidate CpGs linked by <= 1 kb, >= MIN_RUN
> # long; returns a logical matrix of cells belonging to a qualifying run
> run_calls <- function(S, link, seed = NULL, D = NULL, min_mean = NULL) {
+   out <- matrix(FALSE, nrow(S), ncol(S))
+   n <- nrow(S)
+   for (j in seq_len(ncol(S))) {
+     s <- S[, j]; idx <- which(s != 0); if (length(idx) < MIN_RUN) next
+     prev_same <- c(FALSE, s[-1] != 0 & s[-1] == s[-n] & link[-1])
+     rid <- cumsum(!prev_same)[idx]
+     dt <- data.table(i = idx, rid = rid)
+     if (!is.null(seed)) dt[, sd := seed[idx, j]]
+     if (!is.null(D)) dt[, ad := abs(D[idx, j])]
+     keep <- dt[, .(ok = .N >= MIN_RUN &&
+                       (is.null(seed) || any(sd)) &&
+                       (is.null(min_mean) || mean(ad) >= min_mean)), by = rid][ok == TRUE, rid]
+     out[dt[rid %in% keep, i], j] <- TRUE
+   }
+   out
+ }
> 
> # ------------------------------------------------
> # SHARP
> # ------------------------------------------------
> sharp <- function(B, meta, k = "gd", mask = TRUE, harmonise = TRUE, shrink = TRUE,
+                   noisefloor = TRUE, delta = DELTA, region = TRUE, want_score = FALSE) {
+   rows <- if (mask) which(!meta$masked) else seq_len(nrow(B))
+   X <- B[rows, , drop = FALSE]; m <- meta[rows]
+   med0 <- rowMedians(X)
+   R <- X - med0
+   bin <- pmin(floor(med0 * 10), 9L)
+   grp <- paste(m$design, bin)
+   if (harmonise) {
+     for (idx in split(seq_along(grp), grp)) {
+       if (length(idx) < 200) next
+       R[idx, ] <- sweep(R[idx, , drop = FALSE], 2, colMedians(R[idx, , drop = FALSE]))
+     }
+     R <- R - rowMedians(R)
+   }
+   C <- crossprod(R); e <- eigen(C, symmetric = TRUE)
+   sv <- sqrt(pmax(e$values, 0)); ar <- ncol(R) / nrow(R)
+   omega <- 0.56 * ar^3 - 0.95 * ar^2 + 1.82 * ar + 1.43
+   k_gd <- sum(sv > omega * median(sv))
+   k_use <- if (identical(k, "gd")) k_gd else as.integer(k)
+   if (k_use > 0) {
+     V <- e$vectors[, seq_len(k_use), drop = FALSE]
+     R <- R - tcrossprod(R %*% V, V)
+     R <- R - rowMedians(R)
+   }
+   s2 <- rowMads(R)^2
+   d <- 0.37 * (ncol(R) - 1)                 # MAD efficiency ~37% of the SD
+   s2post <- s2; df <- rep(d, length(s2))
+   if (shrink) {
+     for (idx in split(seq_along(grp), grp)) {
+       if (length(idx) < 200) next
+       pr <- fit_prior(s2[idx], d)
+       if (is.finite(pr[["d0"]])) {
+         s2post[idx] <- (pr[["d0"]] * pr[["s02"]] + d * s2[idx]) / (pr[["d0"]] + d)
+         df[idx] <- pr[["d0"]] + d
+       } else { s2post[idx] <- pr[["s02"]]; df[idx] <- 1e6 }
+     }
+   }
+   if (noisefloor) s2post <- pmax(s2post, m$sigma.tech^2)
+   s2post <- pmax(s2post, 1e-8)
+   Z <- R / sqrt(s2post)
+   P <- 2 * pt(-abs(Z), df)
+   Q <- matrix(p.adjust(as.vector(P), "BH"), nrow(P))
+   call <- (Q <= Q_FDR) & (abs(R) >= delta)
+   Scpg <- sign(R) * call
+   Sreg <- NULL
+   if (region) {
+     cand <- sign(R) * ((P <= EXT_P) & (abs(R) >= EXT_D))
+     inrun <- run_calls(cand, m$link, seed = call, D = R, min_mean = delta)
+     Sreg <- sign(R) * inrun
+   }
+   out <- list(rows = rows, cpg = Scpg, region = Sreg, k = k_use, k_gd = k_gd,
+               n.small = sum(Q <= Q_FDR & abs(R) < delta))
+   if (want_score) out$score <- abs(Z) * (abs(R) >= delta) * sign(R)
+   out
+ }

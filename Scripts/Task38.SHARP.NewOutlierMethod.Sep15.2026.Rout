> load_tissue <- function(tissue) {
+   d <- fread(inputs[[tissue]], sep = "\t", showProgress = FALSE)
+   if (QUICK) d <- d[Chromosome %in% c("chr21", "chr22")]
+   chrn <- suppressWarnings(as.integer(sub("chr", "", d$Chromosome)))
+   chrn[d$Chromosome == "chrX"] <- 23L
+   d <- d[order(chrn, d$Start)]
+   cols <- grep(if (tissue == "Normal") "^N[0-9]+$" else "^T[0-9]+$", names(d), value = TRUE)
+   B <- as.matrix(d[, ..cols])
+   meta <- data.table(id = d$Composite.Element.REF, chr = d$Chromosome, pos = d$Start,
+                      st = d$methy.state)
+   meta[, design := man$design[match(id, man$Probe_ID)]]
+   meta[is.na(design), design := "II"]
+   meta[, masked := id %in% msk[M_general == TRUE, Probe_ID]]
+   meta[, link := c(FALSE, chr[-1] == chr[-.N] & diff(pos) <= GAP_BP)]
+   sg <- noise[noise$tissue == tissue]
+   fallback <- sg[methy.state == "ALL", sigma.p10]
+   meta[, sigma.tech := sg$sigma.p10[match(st, sg$methy.state)]]
+   meta[is.na(sigma.tech), sigma.tech := fallback]
+   list(B = B, meta = meta, cols = cols)
+ }

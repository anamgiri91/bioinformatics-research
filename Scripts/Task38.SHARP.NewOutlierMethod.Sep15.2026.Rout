> png(file.path(out_dir, "Fig16_SHARP_Recall.png"), width = 2700, height = 1200, res = 190)
> par(mfrow = c(1, 2), mar = c(4.5, 4.6, 3, 1), las = 1, cex.axis = 0.85)
> for (kd in c("single", "region")) {
+   plot(NA, xlim = c(1, length(EFFECT_LAB)), ylim = c(0, 1), xaxt = "n",
+        xlab = "realised |delta-beta| of the injected change", ylab = "recall (share detected)",
+        main = sprintf("Injected %s outliers (spike set B)", if (kd == "single") "single-CpG" else "regional"))
+   axis(1, at = seq_along(EFFECT_LAB), labels = EFFECT_LAB)
+   for (m in names(PAL)) {
+     e <- eff[kind == kd & method == m]; if (!nrow(e)) next
+     y <- e$recall[match(EFFECT_LAB, e$effect)]
+     lines(seq_along(EFFECT_LAB), y, col = PAL[[m]], lwd = if (grepl("SHARP", m)) 3 else 1.6, type = "b", pch = 16)
+   }
+   if (kd == "single") legend("topleft", bty = "n", cex = 0.75, col = PAL, lwd = 2, legend = names(PAL))
+ }
